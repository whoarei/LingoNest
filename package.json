{
  "name": "lingonest",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "^3.2.0"
  }
}
